# ─── Required ────────────────────────────────────────────────────────────────
# Appwrite server endpoint (include /v1)
APPWRITE_ENDPOINT=https://appwrite.racoondevs.com/v1

# Appwrite project ID
APPWRITE_PROJECT_ID=

# Server-side API key — must have:
#   databases.read   (to scan all documents)
#   databases.write  (only needed for live run)
APPWRITE_API_KEY=

# ─── Optional (defaults shown) ───────────────────────────────────────────────
APPWRITE_DATABASE_ID=main
APPWRITE_COLLECTION_RESOURCES_ID=resources

# ─── Run mode ─────────────────────────────────────────────────────────────────
# Default is dry-run (DRY_RUN=true). Set to "false" to actually write.
# Always run dry first and review the report before going live.
DRY_RUN=true
